@using Deployment.Models
@model IEnumerable<Deployment.Models.Site>
@{
    ViewBag.Title = "Index";
    var project = (Project)ViewBag.Project;
}
<h2>
    All sites of project @project.Name</h2>
<p>
<p>
    @Html.ActionLink("Create New", "Create", new { projectId = project.Id })
</p>
@using (Html.BeginForm("Index", "Site", FormMethod.Get, new { }))
{ 
    @Html.Hidden("ProjectId", project.Id)
    <fieldset>
        <legend>Site Information</legend>
        <div class="editor-label">
            Site name
        </div>
        <div class="editor-field">
            <input type="text" name="SiteName" value="@ViewBag.SiteName" />
        </div>
        <p>
            <input type="submit" value="Search" />
        </p>
    </fieldset>

}
<table style="width: 100%">
    <tr>
        <th>
            <input type="checkbox" data-site-id="0" class="site-id checkbox-all" />
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Url)
        </th>
        <th>
        </th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <input type="checkbox" data-site-id="@item.Id" data-site-name="@item.Name" class="site-id"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Url)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Backup", "Backup", new { id = item.Id }) |
                @Html.ActionLink("Package Log", "Index", "Package", new { siteId = item.Id }, new { })|
                @Html.ActionLink("Backup Log", "Index", "Backup", new { siteId = item.Id }, new { })|
                @Html.ActionLink("Release Log", "Index", "ReleaseLog", new { siteId = item.Id }, new { })
            </td>
        </tr>
    }
    <tr>
        <td>
            <input type="checkbox" data-site-id="0" class="site-id checkbox-all" />
        </td>
        <td colspan="3">
            <a id="backup-all" href="javascript:;">Back up All</a>
        </td>
    </tr>
</table>
<div id="dialog" title="Progress bar" style="display: none;">
    <p id="dialog-text">
    </p>
</div>
@section scripts{
    @Scripts.Render("~/bundles/site")
}
