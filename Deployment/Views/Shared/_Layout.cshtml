<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Deployment Center</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/themes/base/css")
    @Styles.Render("~/Content/themes/base/css")
    <link href="@Url.Content("~/Content/PagedList.css")" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="page">
        <div id="header">
            <div id="title">
                <h1>
                    Deployment Center</h1>
            </div>
            <div id="logindisplay">
                @Html.Partial("_LoginPartial")
            </div>
            <div id="menucontainer">
                <ul id="menu">
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li>@Html.ActionLink("Project", "Index", "Project")</li>
                    <li>@Html.ActionLink("Release Log", "Index", "ReleaseLog")</li>
                </ul>
            </div>
        </div>
        <div id="main">
            @RenderBody()
            <div id="footer">
                &copy; @DateTime.Now.Year - Jacob
            </div>
        </div>
        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/jqueryui")
        @RenderSection("scripts", required: false)
        <script type="text/ecmascript">
            var Global = {};
            Global.resolveClientUrl = function (relativeUrl) {
                return '@Url.Content("~/")' + relativeUrl;
            };
        </script>
    </div>
</body>
</html>
