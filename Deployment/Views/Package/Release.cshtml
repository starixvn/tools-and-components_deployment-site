@using Deployment.Models
@model Package
@{
    ViewBag.Title = "Delete";
    var site = (Site)ViewBag.Site;
}
<h2>
    @site.Name release</h2>
<h3>
    Are you sure you want to release this package?</h3>
@using (Html.BeginForm())
{
    <fieldset>
        <legend>Package</legend>
        <div class="display-label">
            @Html.DisplayNameFor(model => model.Name)
        </div>
        <div class="display-field">
            @Html.DisplayFor(model => model.Name)
        </div>
        <div class="display-label">
            Site
        </div>
        <div class="display-field">
            @site.Name;
        </div>
        <div class="display-label">
            @Html.DisplayNameFor(model => model.Description)
        </div>
        <div class="display-field">
            @Html.DisplayFor(model => model.Description)
        </div>
        <div class="display-label">
            @Html.DisplayNameFor(model => model.Creator)
        </div>
        <div class="display-field">
            @Html.DisplayFor(model => model.Creator)
        </div>
        <div class="display-label">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </div>
        <div class="display-field">
            @Html.DisplayFor(model => model.CreatedDate)
        </div>
        <div class="display-label">
            Backup
        </div>
        <div class="display-field">
            <input type="checkbox" checked="checked" name="IsBackup" value="true"/>
        </div>
    </fieldset>

    <p>
        <input type="submit" value="Release" />
        |
        @Html.ActionLink("Back to List", "Index", new { siteId = Model.SiteId })
    </p>
}
